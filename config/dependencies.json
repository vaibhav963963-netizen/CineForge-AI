        { "path": "engine/scripts/voice.py" }, { "path": "engine/scripts/words.py" }, { "path": "config/characters.json" },
        { "path": "engine/comfy-workflows/sd15-txt2img.json" },
        { "path": "engine/styles/deep-dive/example/vendor/three.module.js" }, { "path": "engine/styles/night-file/example/vendor/three.module.js" },
        { "path": "engine/styles/deep-dive/profile.json" }, { "path": "engine/styles/inside-out/profile.json" }, { "path": "engine/styles/night-file/profile.json" },
        { "path": "engine/styles/paper-atlas/profile.json" }, { "path": "engine/styles/stick-story/profile.json" }, { "path": "engine/styles/tall-tale/profile.json" },
        { "path": "engine/styles/deep-dive/example/fonts/Inter-Black.otf" }, { "path": "engine/styles/paper-atlas/example/fonts/Caladea-Bold.ttf" }, { "path": "engine/styles/night-file/example/fonts/FreeMonoBold.ttf" }
      ] },
