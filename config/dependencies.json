{
  "schemaVersion": 1,
  "about": "Single source of truth for everything CineForge AI needs on a machine. Read by dashboard/lib/setup (scanner, installer, download manager, UI) and by bootstrap.ps1 (Node pin). Paths use {placeholders} resolved from config/studio-config.json, so model/runtime locations live in one place. checksumSource: official = published by the source; tofu = recorded from a verified install because the source publishes none.",
  "trustedHosts": [
    "huggingface.co", "cdn-lfs.huggingface.co", "cdn-lfs.hf.co", "cdn-lfs-us-1.hf.co", "us.aws.cdn.hf.co", "cas-bridge.xethub.hf.co", "transfer.xethub.hf.co",
    "github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com", "codeload.github.com", "raw.githubusercontent.com",
    "download.pytorch.org", "download-r2.pytorch.org",
    "nodejs.org",
    "www.gyan.dev",
    "api.nuget.org", "globalcdn.nuget.org"
  ],
  "categories": {
    "core": "Core system requirements", "runtimes": "Programming runtimes", "python": "Python dependencies", "node": "Node.js dependencies",
    "inference": "AI inference runtimes", "models": "AI models and weights", "audio": "Audio processing", "video": "Video processing",
    "image": "Image generation", "rendering": "Browser and rendering", "assets": "Fonts and visual assets", "tools": "Supporting tools", "optional": "Optional enhancements"
  },
  "hardwareProfiles": [
    { "id": "auto", "name": "Automatic", "description": "Chosen from the detected hardware: NVIDIA GPU accelerated when a CUDA-capable NVIDIA driver is present, otherwise CPU-only." },
    { "id": "nvidia-cuda", "name": "NVIDIA GPU accelerated", "description": "CUDA 12.6 PyTorch for ComfyUI, llama.cpp Vulkan with all layers on the GPU.", "requires": { "nvidiaDriverMin": "527.41", "vramGBMin": 4 } },
    { "id": "cpu", "name": "CPU only", "description": "CPU PyTorch for ComfyUI (--cpu, very slow: minutes per image), llama.cpp CPU build. Everything works, image generation is impractical.", "requires": {} },
    { "id": "low-memory", "name": "Low memory", "description": "GPU where available, but the script model runs with a 4096-token context and ComfyUI uses --lowvram. For 4 GB GPUs or under 12 GB RAM.", "requires": {} }
  ],
  "features": [
    { "id": "dashboard", "name": "Dashboard and job server", "requires": ["node", "studio-files"] },
    { "id": "script-generation", "name": "Script generation (local LLM)", "requires": ["llama-cpp", "gemma-3-4b"] },
    { "id": "fact-check", "name": "Fact check panel", "requires": ["studio-files"], "note": "Pure JavaScript with facts/*.json; no model needed." },
    { "id": "tts", "name": "Voice narration (Kokoro)", "requires": ["python-venv", "python-packages", "kokoro-model", "kokoro-voices"] },
    { "id": "align-english", "name": "Word timing — English", "requires": ["python-venv", "python-packages", "whisper-small-en", "ffmpeg"] },
    { "id": "align-hindi", "name": "Word timing — Hindi / Hinglish", "requires": ["python-venv", "python-packages", "whisper-small", "ffmpeg"] },
    { "id": "hindi-captions", "name": "Devanagari captions", "requires": ["font-devanagari"] },
    { "id": "procedural-visuals", "name": "3D / 2D procedural visuals", "requires": ["browser", "studio-files"] },
    { "id": "ai-images", "name": "Hybrid mode: local AI images", "requires": ["comfyui", "comfyui-venv", "comfyui-torch", "comfyui-requirements", "dreamshaper-8"] },
    { "id": "audio-mix", "name": "Sound cues, music and mix", "requires": ["python-venv", "python-packages", "ffmpeg"] },
    { "id": "video-export", "name": "Frame capture, encoding and QA", "requires": ["browser", "ffmpeg"] }
  ],
  "components": [
    {
      "id": "os", "name": "Windows 10 1803+ / 11 (x64)", "category": "core", "level": "required", "scope": "system",
      "description": "Provides tar.exe (zip extraction) and PowerShell used by the bootstrap.",
      "detect": { "type": "os", "platform": "win32", "arch": ["x64"], "minBuild": 17134 },
      "install": { "type": "manual", "instructions": "CineForge AI supports 64-bit Windows 10 version 1803 (build 17134) or newer." }
    },
    {
      "id": "node", "name": "Node.js", "category": "runtimes", "level": "required", "scope": "workspace",
      "description": "Runs the dashboard, job server, frame capture and tests. No npm packages are used.",
      "version": "22.23.2", "minVersion": "22.0.0", "license": "MIT", "homepage": "https://nodejs.org/",
      "location": "{root}/runtime/node (portable, from the bootstrap) or a system install",
      "detect": { "type": "node" },
      "install": { "type": "bootstrap", "instructions": "Installed by CineForge-Setup.bat before the dashboard can start (portable zip from nodejs.org, SHA-256 checked against SHASUMS256.txt, no PATH change).",
        "artifact": { "url": "https://nodejs.org/dist/v22.23.2/node-v22.23.2-win-x64.zip", "size": 35683585, "sha256": "1177b4137ba5adaa56354ae40f1080c7450e8ae09cecb47da459d1c52ac99f97", "checksumSource": "official" } }
    },
    {
      "id": "npm-packages", "name": "Node.js packages", "category": "node", "level": "required", "scope": "workspace",
      "description": "The dashboard has zero npm dependencies (Node built-ins only), so there is nothing to install. three.js r170 is vendored in engine/styles.",
      "detect": { "type": "npm-none", "packageJson": "{root}/dashboard/package.json" },
      "install": { "type": "none" }
    },
    {
      "id": "tar", "name": "tar.exe (Windows built-in)", "category": "core", "level": "required", "scope": "system",
      "description": "Extracts the FFmpeg, llama.cpp, Python and ComfyUI archives.",
      "detect": { "type": "exec", "exe": "{system32}/tar.exe", "args": ["--version"], "regex": "bsdtar ([\\d.]+)" },
      "install": { "type": "manual", "instructions": "Part of Windows 10 1803 and newer (C:\\Windows\\System32\\tar.exe)." }
    },
    {
      "id": "powershell", "name": "Windows PowerShell", "category": "core", "level": "required", "scope": "system",
      "description": "Used only by the bootstrap and for read-only hardware queries (CIM).",
      "detect": { "type": "exec", "exe": "system:powershell", "args": ["-NoProfile", "-Command", "$PSVersionTable.PSVersion.ToString()"], "regex": "([\\d.]+)" },
      "install": { "type": "manual", "instructions": "Included with Windows." }
    },
    {
      "id": "python-base", "name": "Python 3.12 (base interpreter)", "category": "runtimes", "level": "required", "scope": "workspace",
      "description": "Creates the two isolated environments. An existing Python 3.12 (py launcher) is reused; otherwise the official python.org NuGet package is unpacked into runtime/python312 — no installer, no registry or PATH change.",
      "version": "3.12.10", "minVersion": "3.12.0", "license": "PSF-2.0", "homepage": "https://www.python.org/",
      "location": "{root}/runtime/python312",
      "detect": { "type": "python-base", "portable": "{root}/runtime/python312/python.exe", "major": 3, "minor": 12 },
      "install": { "steps": [
        { "op": "download", "url": "https://api.nuget.org/v3-flatcontainer/python/3.12.10/python.3.12.10.nupkg", "to": "{tmp}/python.3.12.10.nupkg", "size": 14515433, "sha512b64": "u9pNz2iKlCEbYtUJaKkbOPMF0LjR7NkCafdKhvigpPzrt8oWKgdTpHaR6z3wyWQAm9PYGUxv0Zr66NX9AeHMDw==", "checksumSource": "official" },
        { "op": "extract", "archive": "{tmp}/python.3.12.10.nupkg", "fromDir": "tools/", "toDir": "{root}/runtime/python312" },
        { "op": "delete-temp", "path": "{tmp}/python.3.12.10.nupkg" }
      ] },
      "diskBytes": 110000000
    },
    {
      "id": "python-venv", "name": "Studio Python environment", "category": "python", "level": "required", "scope": "workspace",
      "description": "runtime/python-venv: isolated environment for Kokoro, faster-whisper and the audio mixer.",
      "location": "{runtime.pythonVenv}", "dependsOn": ["python-base"],
      "detect": { "type": "python-version", "python": "{python.venv}", "major": 3, "minor": 12 },
      "install": { "steps": [ { "op": "venv", "base": "{python.base}", "target": "{runtime.pythonVenv}" }, { "op": "pip", "python": "{python.venv}", "args": ["install", "--upgrade", "pip"] } ] },
      "diskBytes": 30000000
    },
    {
      "id": "python-packages", "name": "Studio Python packages", "category": "python", "level": "required", "scope": "workspace",
      "description": "Exact pins from config/requirements.txt: numpy, scipy, kokoro-onnx, onnxruntime, faster-whisper, ctranslate2, phonemizer, espeakng-loader (bundles espeak-ng), soundfile, tokenizers, huggingface_hub, PyYAML, tqdm, anyio, colorama.",
      "location": "{runtime.pythonVenv}/Lib/site-packages", "dependsOn": ["python-venv"],
      "detect": { "type": "pip-pins", "python": "{python.venv}", "requirements": "{root}/config/requirements.txt", "imports": ["numpy", "scipy.signal", "scipy.io.wavfile", "kokoro_onnx", "faster_whisper", "soundfile", "espeakng_loader"] },
      "install": { "steps": [ { "op": "pip", "python": "{python.venv}", "args": ["install", "--disable-pip-version-check", "-r", "{root}/config/requirements.txt"] } ] },
      "features": ["tts", "align-english", "align-hindi", "audio-mix"], "diskBytes": 470000000
    },
    {
      "id": "ffmpeg", "name": "FFmpeg + FFprobe 9.0.2", "category": "video", "level": "required", "scope": "workspace",
      "description": "Encoding (libx264/AAC), muxing, loudness and freeze/black QA, audio decoding for Whisper. Portable gyan.dev essentials build.",
      "version": "9.0.2", "minVersion": "6.0", "license": "GPL-3.0", "homepage": "https://www.gyan.dev/ffmpeg/builds/",
      "location": "{runtime.ffmpegBin}",
      "detect": { "type": "ffmpeg", "ffmpeg": "{runtime.ffmpegBin}/ffmpeg.exe", "ffprobe": "{runtime.ffmpegBin}/ffprobe.exe", "encoders": ["libx264", "aac"], "filters": ["freezedetect", "blackdetect", "signalstats"] },
      "install": { "steps": [
        { "op": "download", "url": "https://www.gyan.dev/ffmpeg/builds/packages/ffmpeg-9.0.2-essentials_build.zip", "to": "{tmp}/ffmpeg-9.0.2-essentials_build.zip", "size": 114768076, "sha256": "60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba", "checksumSource": "official" },
        { "op": "extract", "archive": "{tmp}/ffmpeg-9.0.2-essentials_build.zip", "files": { "ffmpeg-9.0.2-essentials_build/bin/ffmpeg.exe": "{runtime.ffmpegBin}/ffmpeg.exe", "ffmpeg-9.0.2-essentials_build/bin/ffprobe.exe": "{runtime.ffmpegBin}/ffprobe.exe", "ffmpeg-9.0.2-essentials_build/LICENSE": "{runtime.ffmpegBin}/../LICENSE" } },
        { "op": "delete-temp", "path": "{tmp}/ffmpeg-9.0.2-essentials_build.zip" }
      ] },
      "features": ["video-export", "audio-mix", "align-english", "align-hindi"], "diskBytes": 300000000
    },
    {
      "id": "browser", "name": "Chrome or Edge (headless WebGL)", "category": "rendering", "level": "required", "scope": "system",
      "description": "Frame-exact capture through the Chrome DevTools Protocol with hardware WebGL (ANGLE). Microsoft Edge ships with Windows 11 and works. Set CHROME=path to choose another Chromium.",
      "homepage": "https://www.google.com/chrome/",
      "detect": { "type": "browser" },
      "install": { "type": "manual", "instructions": "Install Google Chrome from https://www.google.com/chrome/ or keep Microsoft Edge. This is a system-wide program, so CineForge AI does not install it for you." },
      "features": ["procedural-visuals", "video-export"]
    },
    {
