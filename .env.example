# AI Shorts Studio — environment overrides (optional)
# The server reads these from the process environment (it does not load a .env file by itself):
#   set PORT=3000 && node dashboard/server.js
# All paths come from config/studio-config.json and resolve inside this workspace.

PORT=3000

# Use software WebGL instead of the GPU for frame capture (slow; only for machines without a working GPU driver)
# SOFTWARE_GL=1

# Browser used for frame capture (default: installed Google Chrome, else Microsoft Edge)
# CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe

# There are deliberately no "default language / voice / style" settings: every generation must state its options
# explicitly and the backend validates them. Nothing is ever substituted silently.
