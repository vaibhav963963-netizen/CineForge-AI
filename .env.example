# ==============================================================================
# CineForge AI — environment configuration (template)
# ------------------------------------------------------------------------------
# Copy to `.env` and change only what you need: every value below is optional and the
# shown value is the default. Loaded by dashboard/lib/config.js (the ONLY module that
# reads environment variables) at startup; invalid values stop the studio / scheduler
# with a clear message.
#
# Precedence: real environment > .env.<CINEFORGE_ENV> > .env > config/studio-config.json > defaults
# Paths: Windows paths work as written (C:\Tools\chrome.exe or C:/Tools/chrome.exe);
#        relative paths are relative to the Shorts Studio folder.
#
# NO SECRETS IN THIS FILE OR IN .env:
#   · YouTube OAuth client  → youtube\client_secret.json   (git-ignored)
#   · YouTube refresh token → youtube\tokens.dpapi         (encrypted with Windows DPAPI, current user only)
#   Run `node automation\youtube.mjs authorize` once — never paste tokens here.
#
# NOT IN .env (user settings, edited on the dashboard's Automation page and stored in the
# automation database): production time/days, publish time/days, time zone, publish mode,
# videos per day, retries / retry slots / recovery window / quiet hours, resource
# thresholds, topic queue, language / voice / duration for automated runs.
# Workspace layout (models, runtimes, projects folders) stays in config\studio-config.json.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────────
# development | production | test   ("test" is set automatically under `node --test`)
CINEFORGE_ENV=development

# ── Server and dashboard ─────────────────────────────────────────────────────────
# Dashboard / studio API port
PORT=3000
# Bind address — loopback only: 127.0.0.1 | localhost | ::1
HOST=127.0.0.1

# ── Gemma / llama.cpp (local script model) ───────────────────────────────────────
LLM_PORT=8091
# Stop the script model after this many idle seconds (frees GPU memory for TTS / images)
LLM_IDLE_STOP_SECONDS=90

# ── ComfyUI (local AI images) ────────────────────────────────────────────────────
COMFYUI_PORT=8188

# ── FFmpeg and frame capture ─────────────────────────────────────────────────────
# Browser for frame capture (empty = installed Google Chrome, else Microsoft Edge)
CHROME_PATH=

# ── GPU and resource management ──────────────────────────────────────────────────
# Software WebGL for frame capture (slow; only for machines without a working GPU driver)
SOFTWARE_GL=false

# ── Automation scheduler ─────────────────────────────────────────────────────────
# State database (SQLite)
AUTOMATION_DB=logs/automation/automation.db
# Scheduler loop interval in seconds
AUTOMATION_TICK_SECONDS=30
# Studio API the scheduler drives (empty = http://127.0.0.1:<PORT>)
AUTOMATION_STUDIO_URL=

# ── YouTube OAuth and publishing (file locations only — no secrets) ──────────────
YOUTUBE_CLIENT_SECRET_FILE=youtube/client_secret.json
YOUTUBE_TOKEN_FILE=youtube/tokens.dpapi
# YouTube Data API units per day for this Google Cloud project
YOUTUBE_DAILY_QUOTA=10000

# ── Notification settings ────────────────────────────────────────────────────────
# Windows toast for automation warnings / errors
NOTIFY_TOAST=true

# ── Logging and diagnostics ──────────────────────────────────────────────────────
# Minimum level written to the automation event log: debug | info | warn | error
LOG_LEVEL=info
# System Setup state folder override (tests only; empty = logs/setup)
CINEFORGE_SETUP_DIR=

# ── Kokoro TTS · Faster-Whisper · model and runtime paths ───────────────────────
# Configured in config\studio-config.json (workspace layout, managed by System Setup).
# Production schedule · publishing schedule · retry and recovery:
# Automation page / `node automation\cli.mjs set ...` (see docs\automation.md).

# ── Groq API (script writing only — online; never used during video production) ───────────────────
# Paste your key after the = sign. It stays on this computer: masked in logs, never sent to the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Script generation ─────────────────────────────────────────────────────────────────────────────
SCRIPT_GENERATION_PROVIDER=gemini
SCRIPT_GENERATION_ENABLED=true
SCRIPT_GENERATION_TIMEOUT=120000
SCRIPT_GENERATION_MODE=single-request
SCRIPT_GENERATION_MAX_RETRIES=3

# ── Local video production (always offline) ───────────────────────────────────────────────────────
VIDEO_GENERATION_PROVIDER=local
TTS_PROVIDER=local
IMAGE_GENERATION_PROVIDER=local
VIDEO_RENDER_PROVIDER=local

# ── Google Gemini API (script writing only — online; never used during video production) ──────────
# Replace the placeholder with your key. It stays on this computer: masked in logs, never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
