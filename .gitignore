# ==============================================================================
# CineForge AI — .gitignore
# Local-first AI video studio. The repository holds source code, configuration,
# fact files, tests and a few committed evidence projects. Never commit model
# weights, runtimes, generated media, logs, caches, per-machine settings or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# PYTHON ENVIRONMENTS & CACHE
# ------------------------------------------------------------------------------
runtime/python-venv/
runtime/python312/
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# NODE.JS
# ------------------------------------------------------------------------------
runtime/node/
node_modules/
dist/
.npm/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# LOCAL RUNTIMES & BINARIES (installed by System Setup; licences/readmes stay tracked)
# ------------------------------------------------------------------------------
runtime/ffmpeg/bin/
runtime/llama.cpp/*
!runtime/llama.cpp/LICENSE*
!runtime/llama.cpp/README*
runtime/.downloads/
runtime/tmp/
*.exe
*.dll
*.pdb

# ------------------------------------------------------------------------------
# AI MODEL WEIGHTS — NEVER COMMIT MODEL FILES (small config/tokenizer json stays tracked)
# ------------------------------------------------------------------------------
models/**/*.gguf
models/**/*.safetensors
models/**/*.ckpt
models/**/*.onnx
models/**/*.pt
models/**/*.pth
models/**/*.bin
models/**/*.model
models/**/*.tflite
models/**/*.engine
models/image-generation/checkpoints/

# Model caches and downloaded repositories
models/**/blobs/
models/**/snapshots/
models/**/hub/
models/image-generation/cache/
.cache/
hf-cache/
huggingface/
transformers_cache/

# Preserve model directory structure
!models/.gitkeep
!models/**/.gitkeep

# ------------------------------------------------------------------------------
# COMFYUI
# ------------------------------------------------------------------------------
ComfyUI/models/
ComfyUI/output/
ComfyUI/temp/
ComfyUI/input/
ComfyUI/user/
comfyui_models/

# ------------------------------------------------------------------------------
# GENERATED PROJECTS, VIDEO, AUDIO & RENDER OUTPUTS
# ------------------------------------------------------------------------------
# New projects (studio runs, script tests) stay local. Projects committed before
# this rule (evidence/acceptance projects) remain tracked; inside them the heavy
# outputs below are still never added.
projects/*
!projects/.gitkeep
projects/*/renders/
projects/*/review/
projects/*/audio/
projects/*/data/*.wav
projects/*/data/*.mp3
projects/*/data/*.flac
projects/*/data/*.mp4
projects/*/data/*.mkv
projects/*/data/*.webm

exports/*
!exports/.gitkeep

# Generated media files anywhere else
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.flac
*.aac
*.m4a

# ------------------------------------------------------------------------------
# TEMPORARY FRAMES, DOWNLOADS & CHROME PROFILES
# ------------------------------------------------------------------------------
tmp/
temp/
fs-chrome-*/
*.tmp
*.part
*.incomplete
*.lock

# ------------------------------------------------------------------------------
# LOGS, JOB STORE & EVALUATION REPORTS
# ------------------------------------------------------------------------------
logs/
*.log
*.trace

# ------------------------------------------------------------------------------
# SAFETY BACKUPS
# ------------------------------------------------------------------------------
backups/

# ------------------------------------------------------------------------------
# SECRETS & CREDENTIALS
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template

*.pem
*.key
*.pfx
*.p12
*.crt

youtube/tokens.json
youtube/client_secret.json
youtube/credentials.json
credentials/
secrets/

# ------------------------------------------------------------------------------
# PER-MACHINE SETTINGS & LOCAL DATABASES
# ------------------------------------------------------------------------------
config/setup-settings.json
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# OPERATING SYSTEM FILES
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDE, EDITOR & LOCAL AI-ASSISTANT STATE
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.claude/
.cursor/

# ------------------------------------------------------------------------------
# PRESERVE IMPORTANT EMPTY DIRECTORIES
# ------------------------------------------------------------------------------
!youtube/queue/.gitkeep
