{
  "title": "Skeleton Lake Mystery",
  "lines": [
    {
      "text": "Roopkund: a Himalayan glacial lake waits.",
      "visual": "Drone shot of the high-altitude lake in the mountains.",
      "onScreen": "5,020 meters"
    },
    {
      "text": "It’s known as Skeleton Lake, sadly.",
      "visual": "Close-up of exposed bones in the snow.",
      "onScreen": "300-800"
    },
    {
      "text": "Madhwal found remains in 1942, you know.",
      "visual": "Old photo of a forest ranger examining the lake.",
      "onScreen": "1942"
    },
    {
      "text": "The lake freezes, bones appear slowly.",
      "visual": "Time-lapse of snow melting, revealing bones."
    },
    {
      "text": "Ancient DNA reveals separate deaths now.",
      "visual": "Scientist analyzing a bone fragment.",
      "onScreen": "2019"
    },
    {
      "text": "Groups died centuries, a long time ago.",
      "visual": "Timeline graphic showing group deaths.",
      "onScreen": "1,000 years"
    },
    {
      "text": "South Asian ancestry died around 800 CE.",
      "visual": "Artist's depiction of the South Asian group.",
      "onScreen": "800 CE"
    },
    {
      "text": "Mediterranean group died around 1800 CE.",
      "visual": "Panoramic view of the lake and mountains.",
      "onScreen": "1800 CE"
    },
    {
      "text": "Why? A mystery still unsolved, sadly.",
      "visual": "Close-up of the frozen lake surface."
    }
  ],
