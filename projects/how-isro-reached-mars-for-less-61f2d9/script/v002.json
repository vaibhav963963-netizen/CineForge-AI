{
  "title": "Mars Mission Miracle",
  "lines": [
    {
      "text": "सूनो, एकदम अप्रत्याशित कहानी है!।",
      "visual": "A rocket launching from Sriharikota, flames and smoke.",
      "onScreen": "5 नवंबर 2013"
    },
    {
      "text": "इसरो ने मिशन शुरू किया, ₹450 करोड़ बजट के साथ।",
      "visual": "Close-up shot of the PSLV rocket.",
      "onScreen": "₹450 crore"
    },
    {
      "text": "फ़िल्म ग्रेविटी का बजट लगभग 10 करोड़ डॉलर था।",
      "visual": "A poster of the movie Gravity.",
      "onScreen": "10 करोड़ डॉलर"
    },
    {
      "text": "भारतीय वैज्ञानिकों ने मार्स तक पहुँचने का मिशन लिया।",
      "visual": "Satellite orbiting Earth.",
      "onScreen": "2013"
    },
    {
      "text": "उन्होंने एक महीना पृथ्वी के चारों ओर चक्कर लगाया।",
      "visual": "Animated diagram of Earth and a satellite in orbit.",
      "onScreen": "1 महीना"
    },
    {
      "text": "फिर धीरे-धीरे उन्होंने अपना ऑर्बिट बढ़ाया।",
      "visual": "Satellite gradually increasing its orbital altitude.",
      "onScreen": "ऑर्बिट बढ़ाना"
    },
    {
      "text": "1 दिसंबर 2013 को उन्होंने मार्स के लिए चली।",
      "visual": "The spacecraft leaving Earth's orbit.",
      "onScreen": "1 दिसंबर 2013"
    },
    {
      "text": "मार्स तक यात्रा 298 दिनों की थी।",
      "visual": "A timeline showing 298 days.",
      "onScreen": "298 दिन"
    },
    {
      "text": "24 सितंबर 2014 को मंगलयान मार्स की कक्षा में पहुँचा।",
      "visual": "The spacecraft entering Mars orbit.",
      "onScreen": "24 सितंबर 2014"
    },
    {
      "text": "सिर्फ़ 7.4 करोड़ डॉलर में मार्स मिशन पूरा!।",
      "visual": "A graphic showing the Mars orbiter in orbit around Mars.",
      "onScreen": "7.4 करोड़ डॉलर"
    },
    {
      "text": "ऑर्बिटर ने मार्स की कक्षा में 8 साल तक काम किया।",
      "visual": "A graphic showing the mission timeline of 8 years.",
      "onScreen": "8 साल"
    },
    {
      "text": "एकदम कमाल है, ना?।",
      "visual": "A wide shot of Mars from space.",
      "onScreen": "मार्स"
    }
  ],
